<assembly xmlns="http://maven.apache.org/DSJ/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/DSJ/assembly/1.1.3 https://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>release</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <fileSet>
            <directory>qct/native</directory>
            <outputDirectory>native</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>qct/share</directory>
            <outputDirectory>share</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>qct/scripts</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode> <!-- Executable -->
        </fileSet>
    </fileSets>
</assembly>